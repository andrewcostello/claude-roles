{
  "_comment": "Lexical hints for reviewing the historical wiring contract. These patterns match comments and incidental text as well as code. They measure clause mentions, not assertions, behavioral coverage, or acceptance. Do not use them to rank models.",
  "source": "cmd/classify/wiring.go",
  "clauses": [
    {"id": "RW1", "text": "IT IS THE CODE main() RUNS — no parallel spine",
     "probe": ["MainDelegat", "delegat", "parallel spine", "source scan", "RunWiring\\("]},
    {"id": "RW2", "text": "IT NEVER EXITS THE PROCESS",
     "probe": ["NeverTerminat", "os\\.Exit", "TerminatesProcess", "log\\.Fatalf"]},
    {"id": "RW3", "text": "EVERY BYTE PASSES THROUGH A SUPPLIED WRITER",
     "probe": ["Stderr", "captured", "CapturedStderr", "arts\\.Stdout"]},
    {"id": "RW4", "text": "IT REPORTS ARTIFACT STATE, NOT EXISTENCE",
     "probe": ["ArtifactWritten", "ArtifactStale", "ArtifactRemoved", "ArtifactNotApplicable", "\\.State"]},
    {"id": "RW5", "text": "THE ERROR RETURN IS NOT THE RUN'S FAILURE",
     "probe": ["SeamErrors", "NoArtifactClaims", "err != nil", "asserts nothing"]},
    {"id": "RW6", "text": "SUBCOMMANDS ARE IN SCOPE",
     "probe": ["Subcommand", "capabilities", "\"init\"", "--help"]},
    {"id": "RW7", "text": "IT NEVER CALLS os.Chdir",
     "probe": ["Chdir", "ChangingCWD", "working directory"]},
    {"id": "RW8", "text": "main() FORWARDS THE RESULT AND ADDS NOTHING",
     "probe": ["MainForwards", "compiled", "os\\.Stdout", "forwards"]},
    {"id": "PF1", "text": "registers exactly the flags, via the registrar",
     "probe": ["Registrar", "registerContractVersionFlag", "FlagSet"]},
    {"id": "PF2", "text": "does not parse -contract-version",
     "probe": ["raw", "contractVersion", "threaded"]},
    {"id": "PF3", "text": "A FLAG ERROR IS RETURNED, NOT FATAL",
     "probe": ["FlagError", "ContinueOnError", "exit ?2", "exitFlagError"]},
    {"id": "PF4", "text": "does NOT configure the logger",
     "probe": ["SetFlags", "SetPrefix", "logger"]}
  ]
}
